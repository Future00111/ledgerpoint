rn check.promise; },\n   });\n   const recording = recovery.record(review(), owner);\n   assert.equal(recoveryBusy(recovery.getSnapshot()), true);\n@@ -143,7 +143,7 @@ test('double clicks cannot overlap recording, checking or retry requests', async\n   assert.equal(recoveryBusy(recovery.getSnapshot()), true);\n   assert.equal(await recovery.check(), false);\n   assert.equal(await recovery.retry(owner), false);\n-  check.resolve([]); await checking;\n+  check.resolve(unknown()); await checking;\n   assert.equal(posts, 1); assert.equal(reads, 1);\n });\n \n@@ -152,7 +152,7 @@ test('company switch clears recovery and ignores late recording and history resp\n     const late = deferred(), notifications = [];\n     const a = createPaymentRecovery('company-a', {\n       postPayment: operation === 'post' ? () => late.promise : async () => { throw new Error('Unknown'); },\n-      payments: () => late.promise,\n+      recoverPayment: () => late.promise,\n     });\n     a.subscribe(() => notifications.push(a.getSnapshot()?.phase ?? null));\n     let pending = a.record(review(), owner);\n@@ -160,7 +160,7 @@ test('company switch clears recovery and ignores late recording and history resp\n     a.reset();\n     const b = createPaymentRecovery('company-b', {});\n     const count = notifications.length;\n-    late.resolve(operation === 'post' ? { status: 'posted', id: 'synthetic-event', journal_id: 'old-journal' } : rows());\n+    late.resolve(operation === 'post' ? { status: 'posted', id: 'synthetic-event', journal_id: 'old-journal' } : outcome());\n     await pending;\n     assert.equal(a.getSnapshot(), null); assert.equal(b.getSnapshot(), null);\n     assert.equal(notifications.length, count);\n@@ -173,7 +173,7 @@ test('permissions fail closed for writes while status reads remain available aft\n   let writes = 0, reads = 0;\n   const recovery = createPaymentRecovery('company-a', {\n     postPayment: async () => { writes++; throw new Error('Unknown'); },\n-    payments: async () => { reads++; return rows(); },\n+    recoverPayment: async () => { reads++; return outcome(); },\n   });\n   for (const capabilities of [undefined, {}, viewer, admin, { post_payments: 'true' }]) {\n     assert.equal(await recovery.record(review(), capabilities), false);\n"}, {"commit": "3d50d18458efae0988e16487cedd31cda3c82864", "patch": "diff --git a/tools/accounting-flow/restore-drill.mjs b/tools/accounting-flow/restore-drill.mjs\nindex 87596fa..eaefc6c 100644\n--- a/tools/accounting-flow/restore-drill.mjs\n+++ b/tools/accounting-flow/restore-drill.mjs\n@@ -4,6 +4,7 @@ import { createHash } from 'node:crypto';\n import { execFileSync } from 'node:child_process';\n import { realpathSync } from 'node:fs';\n import path from 'node:path';\n+import { recoverApplicationArchive } from '../operations/backup-restore/application-recovery.mjs';\n \n const SOURCE = 'ledgerly_accounting_flow_test';\n const RESTORED = 'ledgerly_accounting_flow_restore_test';\n@@ -117,7 +118,8 @@ export async function runRestoreDrill({ Client, directory, socket, port }) {\n     catch(error) {if(error.code!=='42501') throw error;denied=true;}\n     finally {await runtime.query('ROLLBACK');}\n     if(!denied) throw new Error('Restored runtime unexpectedly permits source content changes.');\n-    return { syntheticOnly: true, sourceUnchanged: true, restoredTables: before.tables.length,\n+    const encryptedApplicationRecovery = await recoverApplicationArchive({ Client, directory, archive, source, before, fingerprintDatabase, assertSameFingerprint });\n+    return { encryptedApplicationRecovery, syntheticOnly: true, sourceUnchanged: true, restoredTables: before.tables.length,\n       restoredRows: before.tables.reduce((sum, table) => sum + table.rows, 0),\n       sourceFingerprint: digest(before), restoredFingerprint: digest(after), runtimeRestricted: true,\n       controlsPreserved: true, runtimeMutationDenied: true, ambientDatabaseCredentialsUsed: false, productionContact: false };\ndiff --git a/tools/operations/backup-restore/application-recovery.mjs b/tools/operations/backup-restore/application-recovery.mjs\nnew file mode 100644\nindex 0000000..e860a0d\n--- /dev/null\n+++ b/tools/operations/backup-restore/application-recovery.mjs\n@@ -0,0 +1,94 @@\n+// Restore the populated disposable accounting fixture into a NEW cluster.\n+// No caller-selected target, database URL, credential or external destination.\n+import { mkdtempSync, mkdirSync, writeFileSync, readFileSync, rmSync, realpathSync } from 'node:fs';\n+import { execFileSync } from 'node:child_process';\n+import { randomBytes } from 'node:crypto';\n+import { performance } from 'node:perf_hooks';\n+import path from 'node:path';\n+import { transformFile } from './archive.mjs';\n+\n+const roleSQL = `SELECT rolname,rolsuper,rolinherit,rolcreaterole,rolcreatedb,rolcanlogin,rolreplication,rolbypassrls\n+  FROM pg_roles WHERE rolname IN ('ledgerly_api','ledgerly_canonical_owner') ORDER BY rolname`;\n+const membershipSQL = `SELECT parent.rolname role_name,member.rolname member_name,m.admin_option\n+  FROM pg_auth_members m JOIN pg_roles parent ON parent.oid=m.roleid JOIN pg_roles member ON member.oid=m.member\n+  WHERE parent.rolname IN ('ledgerly_api','ledgerly_canonical_owner') OR member.rolname IN ('ledgerly_api','ledgerly_canonical_owner')\n+  ORDER BY role_name,member_name`;\n+export function assertApplicationArchive({ directory, archive }) {\n+  if (typeof directory !== 'string' || !/^\\/tmp\\/ledgerly-accounting-flow-tests-[a-zA-Z0-9]{6}$/.test(directory) ||\n+      archive !== path.join(directory, 'synthetic-accounting.dump')) throw new Error('Only the populated disposable accounting archive is allowed.');\n+}\n+export function assertApplicationRoles(roles, memberships) {\n+  const expected = ['ledgerly_api', 'ledgerly_canonical_owner'].map((rolname, i) => ({\n+    rolname, rolsuper: false, rolinherit: true, rolcreaterole: false, rolcreatedb: false,\n+    rolcanlogin: i === 0, rolreplication: false, rolbypassrls: false,\n+  }));\n+  if (JSON.stringify(roles) !== JSON.stringify(expected) || memberships.length !== 0)\n+    throw new Error('Application recovery requires the exact restricted role contract.');\n+}\n+export async function recoverApplicationArchive({ Client, directory, archive, source, before, fingerprintDatabase, assertSameFingerprint }) {\n+  assertApplicationArchive({ directory, archive });\n+  if (realpathSync(directory) !== directory || realpathSync(archive) !== archive) throw new Error('Recovery source must not use symlinks.');\n+  assertApplicationRoles((await source.query(roleSQL)).rows, (await source.query(membershipSQL)).rows);\n+  const receiptPath = new URL('../../../generated-artifacts/application-recovery.json', import.meta.url);\n+  mkdirSync(new URL('../../../generated-artifacts/', import.meta.url), { recursive: true });\n+  const sourceCommit = execFileSync('git', ['rev-parse', 'HEAD'], { cwd: new URL('../../../', import.meta.url), encoding: 'utf8' }).trim();\n+  const base = mkdtempSync('/tmp/ledgerpoint-application-recovery-');\n+  const socket = path.join(base, 'socket'), data = path.join(base, 'data'), port = 55443;\n+  const env = { PATH: process.env.PATH, HOME: base, LANG: 'C', LC_ALL: 'C' };\n+  const run = (command, args) => execFileSync(command, args, { env, stdio: 'pipe', timeout: 60000 });\n+  const clients = [], started = performance.now();\n+  let startupAttempted = false, stopped = true, removed = false, verified = false, failure;\n+  try {\n+    mkdirSync(socket, { mode: 0o700 });\n+    const keyFile = path.join(base, 'key'), encrypted = path.join(base, 'application.enc'), recovered = path.join(base, 'authenticated.dump');\n+    writeFileSync(keyFile, randomBytes(32), { flag: 'wx', mode: 0o600 });\n+    transformFile({ mode: 'encrypt', input: archive, output: encrypted, keyFile, syntheticOnly: true });\n+    transformFile({ mode: 'decrypt', input: encrypted, output: recovered, keyFile, syntheticOnly: true });\n+    if (!readFileSync(archive).equals(readFileSync(recovered))) throw new Error('Authenticated application archive bytes differ.');\n+    run('initdb', ['-D', data, '-U', 'w03_bootstrap', '-A', 'trust', '--no-locale', '--encoding=UTF8']);\n+    startupAttempted = true; stopped = false;\n+    run('pg_ctl', ['-D', data, '-l', path.join(base, 'postgres.log'), '-o', `-h '' -k ${socket} -p ${port} -F`, '-w', 'start']);\n+    const connect = async user => {\n+      const client = new Client({ host: socket, port, user, database: 'postgres', password: () => '', ssl: false, options: '-c timezone=UTC' });\n+      clients.push(client); await client.connect(); return client;\n+    };\n+    const restored = await connect('w03_bootstrap');\n+    const { rows: [identity] } = await restored.query(\"SELECT current_setting('data_directory') directory, inet_server_addr() address, current_database() database, current_user actor\");\n+    if (identity.directory !== data || identity.address !== null || identity.database !== 'postgres' || identity.actor !== 'w03_bootstrap')\n+      throw new Error('New application recovery cluster identity mismatch.');\n+    await restored.query(`CREATE ROLE ledgerly_api LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;\n+      CREATE ROLE ledgerly_canonical_owner NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS`);\n+    // Restore only authenticated bytes; never use the original plaintext dump here.\n+    run('pg_restore', ['-h', socket, '-p', String(port), '-U', 'w03_bootstrap', '-d', 'postgres', '--exit-on-error', recovered]);\n+    assertSameFingerprint(before, await fingerprintDatabase(restored));\n+    assertSameFingerprint(before, await fingerprintDatabase(source));\n+    assertApplicationRoles((await restored.query(roleSQL)).rows, (await restored.query(membershipSQL)).rows);\n+    const runtime = await connect('ledgerly_api');\n+    await runtime.query('SELECT id FROM accounting_document_sources LIMIT 1');\n+    await runtime.query('SELECT id FROM document_intake_sources LIMIT 1');\n+    await runtime.query('BEGIN');\n+    let denied = false;\n+    try { await runtime.query('UPDATE document_intake_sources SET content=content WHERE false'); }\n+    catch (error) { if (error.code !== '42501') throw error; denied = true; }\n+    finally { await runtime.query('ROLLBACK'); }\n+    if (!denied) throw new Error('Recovered runtime can mutate original source content.');\n+    verified = true;\n+  } catch (error) { failure = error; }\n+  finally {\n+    await Promise.allSettled(clients.map(client => client.end()));\n+    if (startupAttempted) {\n+      try { run('pg_ctl', ['-D', data, '-m', 'immediate', '-w', 'stop']); stopped = true; }\n+      catch { stopped = false; }\n+    }\n+    if (stopped) { rmSync(base, { recursive: true, force: true }); removed = true; }\n+    writeFileSync(receiptPath, JSON.stringify({ sourceCommit, syntheticOnly: true, verified,\n+      separateCluster: true, encryptedArchiveUsed: verified, applicationFingerprintMatched: verified,\n+      sourceUnchanged: verified, runtimeRestricted: verified, runtimeMutationDenied: verified,\n+      postgresStopped: stopped, directoryRemoved: removed, elapsedMilliseconds: Math.round(performance.now() - started),\n+      ambientDatabaseCredentialsUsed: false, productionContact: false,\n+      fixtureScope: 'Populated accounting regression schema, source attachments and audit; not production/offsite recovery qualification' }, null, 2) + '\\n');\n+  }\n+  if (failure) throw failure;\n+  if (!verified || !stopped || !removed) throw new Error('Application recovery or isolated cleanup failed; inspect application-recovery.json.');\n+  return JSON.parse(readFileSync(receiptPath, 'utf8'));\n+}\ndiff --git a/tools/operations/backup-restore/application-recovery.test.mjs b/tools/operations/backup-restore/application-recovery.test.mjs\nnew file mode 100644\nindex 0000000..f88ad53\n--- /dev/null\n+++ b/tools/operations/backup-restore/application-recovery.test.mjs\n@@ -0,0 +1,27 @@\n+import test from 'node:test';\n+import assert from 'node:assert/strict';\n+import { assertApplicationArchive, assertApplicationRoles } from './application-recovery.mjs';\n+test('application recovery rejects existing/shared and redirected archive inputs', () => {\n+  const directory = '/tmp/ledgerly-accounting-flow-tests-Ab1234';\n+  assert.doesNotThrow(() => assertApplicationArchive({ directory, archive: `${directory}/synthetic-accounting.dump` }));\n+  for (const pair of [\n+    { directory: '/tmp/production', archive: '/tmp/production/synthetic-accounting.dump' },\n+    { directory, archive: '/tmp/other.dump' },\n+    { directory, archive: `${directory}/../synthetic-accounting.dump` },\n+    { directory: `${directory}/data`, archive: `${directory}/data/synthetic-accounting.dump` },\n+  ]) assert.throws(() => assertApplicationArchive(pair), /disposable accounting archive/);\n+});\n+test('restored application roles reject elevated flags, login owner and unexpected memberships', () => {\n+  const roles = ['ledgerly_api', 'ledgerly_canonical_owner'].map((rolname, i) => ({\n+    rolname, rolsuper: false, rolinherit: true, rolcreaterole: false, rolcreatedb: false,\n+    rolcanlogin: i === 0, rolreplication: false, rolbypassrls: false,\n+  }));\n+  assert.doesNotThrow(() => assertApplicationRoles(roles, []));\n+  for (const field of ['rolsuper','rolcreaterole','rolcreatedb','rolreplication','rolbypassrls']) {\n+    const changed = structuredClone(roles); changed[0][field] = true;\n+    assert.throws(() => assertApplicationRoles(changed, []), /restricted role contract/);\n+  }\n+  assert.throws(() => assertApplicationRoles([{...roles[0]}, {...roles[1], rolcanlogin: true}], []), /restricted role contract/);\n+  assert.throws(() => assertApplicationRoles(roles, [{role_name:'ledgerly_canonical_owner',member_name:'ledgerly_api',admin_option:false}]), /restricted role contract/);\n+  assert.throws(() => assertApplicationRoles(roles.slice(0,1), []), /restricted role contract/);\n+});\n"}, {"commit": "c2245dc8bd779299ded7d3703e73ba904ddcb53e", "patch": "diff --git a/artifacts/api-server/src/services/tax/contracts/caseRegistry.mjs b/artifacts/api-server/src/services/tax/contracts/caseRegistry.mjs\nindex aef2ca1..48c7284 100644\n--- a/artifacts/api-server/src/services/tax/contracts/caseRegistry.mjs\n+++ b/artifacts/api-server/src/services/tax/contracts/caseRegistry.mjs\n@@ -58,6 +58,33 @@ function validPayrollPrerequisites(registry) {\n   const years = new Set(registry.cases.filter(row => row.selector?.domain === 'payroll').map(row => row.selector.taxYear));\n   return matrix.taxYears.length === years.size && matrix.taxYears.every(year => years.has(year));\n }\n+// Tax scope feeds fixture/engine tasks while each calculation remains fail-closed.\n+const taxFamilies = Object.freeze({ vat: ['P08', 5], income: ['P10', 7], corporation: ['P11', 7] });\n+function validTaxPrerequisites(registry) {\n+  if (!plain(registry.taxPrerequisites)\n+    || Object.keys(registry.taxPrerequisites).length !== Object.keys(taxFamilies).length) return false;\n+  for (const [domain, [prefix, count]] of Object.entries(taxFamilies)) {\n+    const matrix = registry.taxPrerequisites[domain];\n+    if (!plain(matrix) || matrix.status !== 'declared_requirements_not_engine_qualification'\n+      || !Object.hasOwn(registry.sources, matrix.sourceId) || !names(matrix.taxYears)\n+      || !nonempty(matrix.scopePolicy) || !plain(matrix.nextTasks)\n+      || !nonempty(matrix.nextTasks['P04-02']) || !nonempty(matrix.nextTasks['P04-03'])\n+      || !Array.isArray(matrix.families) || matrix.families.length !== count) return false;\n+    const expected = new Set(Array.from({length:count}, (_, i) => `${prefix}-${String(i + 1).padStart(2, '0')}`));\n+    const ids = new Set();\n+    for (const family of matrix.families) {\n+      if (!plain(family) || !nonempty(family.id) || ids.has(family.id)\n+        || !expected.delete(family.backlogTask) || family.status !== 'unqualified'\n+        || !nonempty(family.owner) || !names(family.variants)\n+        || !names(family.requiredInputs) || !names(family.requiredOutputs)\n+        || !nonempty(family.acceptanceScenario) || family.expectedResultEvidence !== null) return false;\n+      ids.add(family.id);\n+    }\n+    const years = new Set(registry.cases.filter(row => row.selector.domain === domain).map(row => row.selector.taxYear));\n+    if (matrix.taxYears.length !== years.size || !matrix.taxYears.every(year => years.has(year))) return false;\n+  }\n+  return true;\n+}\n export function validateCaseRegistry(registry) {\n   if (!plain(registry) || registry.version !== 1 || registry.enginePolicy !== 'in_house_only'\n     || !plain(registry.sources) || !Array.isArray(registry.cases) || registry.cases.length === 0\n@@ -90,6 +117,7 @@ export function validateCaseRegistry(registry) {\n     ids.add(row.id); selectors.add(signature(row.selector));\n   }\n   if (!validPayrollPrerequisites(registry)) throw new Error('INVALID_PAYROLL_PREREQUISITES');\n+  if (!validTaxPrerequisites(registry)) throw new Error('INVALID_TAX_PREREQUISITES');\n   return registry;\n }\n export function resolveQualifiedCase(registry, selector) {\ndiff --git a/artifacts/api-server/src/services/tax/contracts/caseRegistry.test.mjs b/artifacts/api-server/src/services/tax/contracts/caseRegistry.test.mjs\nindex 1a9de8b..86d9033 100644\n--- a/artifacts/api-server/src/services/tax/contracts/caseRegistry.test.mjs\n+++ b/artifacts/api-server/src/services/tax/contracts/caseRegistry.test.mjs\n@@ -114,3 +114,43 @@ test('malformed case rows retain the registry validation boundary', () => {\n     assert.throws(()=>validateCaseRegistry(r), /^Error: INVALID_CASE_REGISTRY$/);\n   }\n });\n+\n+test('tax prerequisite families retain every original VAT, income and corporation scope bullet', () => {\n+  const backlog = JSON.parse(readFileSync(new URL('../../../../../../docs/development/work-backlog.json', import.meta.url)));\n+  for (const [domain, prefix] of [['vat','P08'], ['income','P10'], ['corporation','P11']]) {\n+    const expected = backlog.tasks.filter(t => t.id.startsWith(`${prefix}-`) && Number(t.id.slice(4)) < 80).map(t => t.id).sort();\n+    const matrix = registry.taxPrerequisites[domain];\n+    assert.deepEqual(matrix.families.map(f => f.backlogTask).sort(), expected);\n+    assert.ok(matrix.families.every(f => f.status === 'unqualified' && f.expectedResultEvidence === null));\n+    assert.deepEqual(matrix.taxYears, [...new Set(registry.cases.filter(c => c.selector.domain === domain).map(c => c.selector.taxYear))]);\n+  }\n+  // Declared combinations cannot turn the broad discovery rows into calculation support.\n+  const income = registry.cases.find(c => c.selector.domain === 'income').selector;\n+  assert.deepEqual(resolveQualifiedCase(registry, {...income, income:'employment_dividends_property'}), {ok:false,code:'UNKNOWN_CASE'});\n+});\n+test('incomplete, duplicated, cross-domain or speculative tax prerequisite records fail closed', () => {\n+  const mutations = [\n+    r => delete r.taxPrerequisites,\n+    r => r.taxPrerequisites.invented = r.taxPrerequisites.vat,\n+    r => r.taxPrerequisites.vat = null,\n+    r => r.taxPrerequisites.income.families.pop(),\n+    r => r.taxPrerequisites.corporation.families[1].backlogTask = 'P11-01',\n+    r => r.taxPrerequisites.vat.families[0].backlogTask = 'P09-01',\n+    r => r.taxPrerequisites.vat.families[0] = null,\n+    r => r.taxPrerequisites.vat.families[1].id = r.taxPrerequisites.vat.families[0].id,\n+    r => r.taxPrerequisites.income.families[0].requiredInputs = [],\n+    r => r.taxPrerequisites.income.families[0].requiredOutputs = [],\n+    r => r.taxPrerequisites.income.families[0].variants = [],\n+    r => r.taxPrerequisites.income.families[0].acceptanceScenario = '',\n+    r => r.taxPrerequisites.corporation.families[0].status = 'supported',\n+    r => r.taxPrerequisites.corporation.families[0].expectedResultEvidence = {passed:true},\n+    r => r.taxPrerequisites.corporation.taxYears.pop(),\n+    r => r.taxPrerequisites.corporation.taxYears.push('2028-29'),\n+    r => r.taxPrerequisites.vat.sourceId = 'unknown',\n+    r => delete r.taxPrerequisites.vat.nextTasks['P04-03'],\n+  ];\n+  for (const mutate of mutations) {\n+    const r=clone(); mutate(r);\n+    assert.throws(() => resolveQualifiedCase(r, registry.cases[0].selector), /^Error: INVALID_TAX_PREREQUISITES$/);\n+  }\n+});\ndiff --git a/docs/development/tax-payroll-supported-cases.json b/docs/development/tax-payroll-supported-cases.json\nindex 0175edb..0d5b424 100644\n--- a/docs/development/tax-payroll-supported-cases.json\n+++ b/docs/development/tax-payroll-supported-cases.json\n@@ -20,8 +20,8 @@\n   \"sources\": {\n     \"vat\": {\n       \"url\": \"https://www.gov.uk/guidance/vat-guide-notice-700\",\n-      \"checkedAt\": \"2026-10-30\",\n-      \"evidence\": \"Official source located; rates, schemas and calculation fixtures not yet pinned or independently reviewed.\"\n+      \"checkedAt\": \"2026-10-31\",\n+      \"evidence\": \"Official VAT Notice 700 inspected for scheme and transaction requirements; this discovery source is not a year-specific calculation rule or qualified return fixture.\"\n     },\n     \"schemes\": {\n       \"url\": \"https://www.gov.uk/how-vat-works/vat-schemes\",\n@@ -57,6 +57,16 @@\n       \"url\": \"https://www.gov.uk/government/publications/software-developers-payroll-test-data-2026-to-2027\",\n       \"checkedAt\": \"2026-10-31\",\n       \"evidence\": \"Official PAYE v1.1 ZIP bytes pinned; 168 cached reference rows across 22 regional sheets extracted. No native PAYE engine or statutory qualification claimed.\"\n+    },\n+    \"incomeIndividual2026\": {\n+      \"url\": \"https://www.gov.uk/government/publications/self-assessment-technical-specifications-2026-for-individual-returns\",\n+      \"checkedAt\": \"2026-10-31\",\n+      \"evidence\": \"Official individual-return spe