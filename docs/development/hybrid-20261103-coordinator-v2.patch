+    fails(() => move(invalid, { type: 'renew', ...owner, leaseMs: 1000 }, { now: 201 }), 'INVALID_STATE');
+  }
+  for (const invalid of [{ ...active, lease: { ...identity, token: owner.token } }, { ...active, version: 3 }])
+    fails(() => move(invalid, { type: 'renew', ...owner, leaseMs: 1000 }, { now: 201 }), 'INVALID_STATE');
+});
