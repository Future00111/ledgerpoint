@@ -0,0 +1,49 @@
+-- Partial prerequisite ONLY: no agreement admission or conditional credit.
+-- Review/disposable installation only; not in the executable registry yet.
+CREATE TABLE conditional_discount_commit_witnesses (
+  company_id uuid NOT NULL,
+  event_id uuid NOT NULL,
+  journal_id uuid NOT NULL CONSTRAINT conditional_discount_witness_journal_fk REFERENCES canonical_journal_entries(id),
+  event_source_hash text NOT NULL CONSTRAINT conditional_discount_witness_hash CHECK(event_source_hash ~ '^sha256:[a-f0-9]{64}$'),
+  actor_id text NOT NULL,
+  event_created_at timestamptz NOT NULL,
+  observed_at timestamptz NOT NULL,
+  CONSTRAINT conditional_discount_witness_pk PRIMARY KEY(company_id,event_id),
+  CONSTRAINT conditional_discount_witness_event_fk FOREIGN KEY(company_id,event_id) REFERENCES accounting_payment_events(company_id,id),
+  CONSTRAINT conditional_discount_witness_clock CHECK(observed_at > event_created_at)
+);
+CREATE FUNCTION conditional_discount_witness_immutable() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN RAISE EXCEPTION 'Conditional discount commitment witnesses are immutable'; END $$;
+-- The xmin check below rejects a top-level same-transaction insert ONLY. It is
+-- NOT qualified against subtransactions, XID wraparound or frozen old rows.
+-- The service fresh-transaction boundary remains mandatory; this review SQL
+-- cannot authorize conditional admission until disposable PostgreSQL tests pass.
+CREATE FUNCTION conditional_discount_witness_observe() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE source_row accounting_payment_events%ROWTYPE; source_xid bigint;
+BEGIN
+  SELECT e.* INTO source_row FROM accounting_payment_events e
+    WHERE e.company_id=NEW.company_id AND e.id=NEW.event_id;
+  IF NOT FOUND THEN RAISE EXCEPTION 'Native payment event required'; END IF;
+  SELECT xmin::text::bigint INTO source_xid FROM accounting_payment_events
+    WHERE company_id=NEW.company_id AND id=NEW.event_id;
+  IF source_xid = txid_current() % 4294967296 OR
+     source_row.journal_id <> NEW.journal_id OR source_row.kind NOT IN ('payment','allocation') THEN
+    RAISE EXCEPTION 'A separately committed native payment or allocation is required';
+  END IF;
+  -- Ignore caller timestamps; the observed source already exists at this clock.
+  NEW.event_created_at := source_row.created_at;
+  NEW.observed_at := clock_timestamp();
+  RETURN NEW;
+END $$;
+CREATE TRIGGER conditional_discount_witness_observe BEFORE INSERT ON conditional_discount_commit_witnesses
+ FOR EACH ROW EXECUTE FUNCTION conditional_discount_witness_observe();
+CREATE TRIGGER conditional_discount_witness_immutable BEFORE UPDATE OR DELETE ON conditional_discount_commit_witnesses
+ FOR EACH ROW EXECUTE FUNCTION conditional_discount_witness_immutable();
+CREATE TRIGGER conditional_discount_witness_no_truncate BEFORE TRUNCATE ON conditional_discount_commit_witnesses
+ FOR EACH STATEMENT EXECUTE FUNCTION conditional_discount_witness_immutable();
+ALTER TABLE conditional_discount_commit_witnesses ENABLE ALWAYS TRIGGER conditional_discount_witness_observe;
+ALTER TABLE conditional_discount_commit_witnesses ENABLE ALWAYS TRIGGER conditional_discount_witness_immutable;
+ALTER TABLE conditional_discount_commit_witnesses ENABLE ALWAYS TRIGGER conditional_discount_witness_no_truncate;
+REVOKE ALL ON conditional_discount_commit_witnesses FROM PUBLIC;
+GRANT SELECT,INSERT ON conditional_discount_commit_witnesses TO ledgerly_api;
+REVOKE UPDATE,DELETE,TRUNCATE ON conditional_discount_commit_witnesses FROM ledgerly_api;
