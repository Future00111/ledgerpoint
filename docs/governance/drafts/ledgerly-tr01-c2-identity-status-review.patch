+          TR01_VALIDATION_RESULT: ${{ needs.validate.result }}
+          TR01_APPROVED_WORKFLOW_SHA: ${{ vars.TR01_C2_APPROVED_WORKFLOW_SHA }}
+        run: node scripts/ci/ledgerly-tr01-c2-identity-status.mjs
