+    timeout-minutes: 15
+    permissions:
+      contents: read
+    steps:
+      - name: Checkout exact immutable C2 without persisted credentials
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
