 import Ajv2020 from "ajv/dist/2020.js";
 
 const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../..");
-const candidateRef = "refs/heads/tr01/implementation-identity-successor-c4";
+const candidateRef = "refs/heads/tr01/implementation-identity-successor-c5";
 const mainRef = "refs/heads/main";
 const sha = "a".repeat(40);
 
@@ -264,6 +264,15 @@ const candidateTrusted = await candidateModule.buildTrustedEvidenceContext(
   fixtureCi(candidateEnvironment), candidateManifest,
 );
 for (const [label, overrides, rejection] of [
+    ["old C4 ref", {
+      GITHUB_REF: "refs/heads/tr01/implementation-identity-successor-c4",
+    }, /identity mode requires/],
+    ["old C4 workflow alias", {
+      GITHUB_WORKFLOW_REF: "example/repository/.github/workflows/ledgerly-canonical-postgresql.yml@refs/heads/tr01/implementation-identity-successor-c4",
+    }, /exact approved workflow identity/],
+    ["stale C4 candidate pin", {
