{
  "name": "PurchaseBillLine",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company"
    },
    "purchase_bill_id": {
      "type": "string",
      "description": "Reference to PurchaseBill"
    },
    "description": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "unit_price": {
      "type": "number",
      "default": 0
    },
    "vat_rate": {
      "type": "number",
      "default": 20
    },
    "amount": {
      "type": "number",
      "description": "Net line amount (quantity * unit_price)",
      "default": 0
    },
    "vat_amount": {
      "type": "number",
      "default": 0
    },
    "line_total": {
      "type": "number",
      "description": "amount + vat_amount",
      "default": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "parts",
        "tools",
        "utilities",
        "rent",
        "insurance",
        "wages",
        "fuel",
        "office",
        "professional_fees",
        "other"
      ],
      "default": "other"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "company_id",
    "purchase_bill_id",
    "description"
  ]
}