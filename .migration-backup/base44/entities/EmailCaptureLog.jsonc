{
  "name": "EmailCaptureLog",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company"
    },
    "email_sender": {
      "type": "string"
    },
    "email_subject": {
      "type": "string"
    },
    "attachment_name": {
      "type": "string"
    },
    "date_found": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "captured",
        "ignored"
      ],
      "default": "captured"
    },
    "email_account_id": {
      "type": "string",
      "description": "Reference to EmailAccount"
    },
    "document_id": {
      "type": "string",
      "description": "Reference to Document if captured"
    }
  },
  "required": [
    "company_id"
  ]
}