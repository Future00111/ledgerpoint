{
  "name": "SalesInvoice",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "payment_terms": {
      "type": "number",
      "enum": [
        7,
        14,
        30,
        60
      ],
      "default": 30
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "part_paid",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "draft"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "vat_rate": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "description": "Net amount (quantity * unit_price)"
          },
          "vat_amount": {
            "type": "number"
          },
          "line_total": {
            "type": "number",
            "description": "Gross amount (amount + vat_amount)"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "vat_total": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "balance_due": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "customer_id",
    "invoice_number",
    "issue_date",
    "due_date"
  ]
}