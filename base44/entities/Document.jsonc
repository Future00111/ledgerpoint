{
  "name": "Document",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company"
    },
    "name": {
      "type": "string",
      "description": "Document name or label"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "purchase_invoice",
        "sales_invoice",
        "receipt",
        "credit_note",
        "bank_statement",
        "other"
      ],
      "default": "other"
    },
    "upload_date": {
      "type": "string",
      "format": "date"
    },
    "document_date": {
      "type": "string",
      "format": "date"
    },
    "supplier_or_customer": {
      "type": "string",
      "description": "Name of supplier or customer"
    },
    "reference_number": {
      "type": "string"
    },
    "net_amount": {
      "type": "number",
      "default": 0
    },
    "vat_amount": {
      "type": "number",
      "default": 0
    },
    "gross_amount": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_extraction",
        "pending_review",
        "approved",
        "rejected"
      ],
      "default": "pending_extraction"
    },
    "file_url": {
      "type": "string",
      "description": "URL of the uploaded original file"
    },
    "file_size": {
      "type": "number"
    },
    "mime_type": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "name",
    "document_type"
  ]
}