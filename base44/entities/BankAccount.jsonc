{
  "name": "BankAccount",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company"
    },
    "account_name": {
      "type": "string",
      "description": "Name of the bank account (e.g., Business Account)"
    },
    "bank_name": {
      "type": "string",
      "description": "Name of the bank"
    },
    "sort_code": {
      "type": "string",
      "description": "Bank sort code (UK format: XX-XX-XX)"
    },
    "account_number": {
      "type": "string",
      "description": "Bank account number"
    },
    "currency": {
      "type": "string",
      "default": "GBP",
      "description": "Currency code (e.g., GBP, EUR, USD)"
    },
    "opening_balance": {
      "type": "number",
      "default": 0,
      "description": "Opening balance when account was created"
    },
    "current_balance": {
      "type": "number",
      "default": 0,
      "description": "Current balance calculated from transactions"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "connection_type": {
      "type": "string",
      "enum": [
        "manual",
        "csv_import",
        "open_banking"
      ],
      "default": "manual",
      "description": "How transactions are imported"
    },
    "open_banking_status": {
      "type": "string",
      "enum": [
        "not_connected",
        "connected",
        "expired",
        "error"
      ],
      "default": "not_connected",
      "description": "Open Banking connection status"
    },
    "open_banking_provider": {
      "type": "string",
      "enum": [
        "plaid",
        "truelayer",
        "yapily",
        "tink",
        "other"
      ],
      "description": "Open Banking provider"
    },
    "last_sync_date": {
      "type": "string",
      "format": "date-time",
      "description": "Last time transactions were synced from Open Banking"
    },
    "next_sync_date": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled next sync date"
    },
    "consent_expiry_date": {
      "type": "string",
      "format": "date-time",
      "description": "When Open Banking consent expires"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or reference information"
    }
  },
  "required": [
    "company_id",
    "account_name",
    "bank_name",
    "sort_code",
    "account_number"
  ]
}