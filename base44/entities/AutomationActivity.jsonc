{
  "name": "AutomationActivity",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company"
    },
    "automation_id": {
      "type": "string",
      "description": "Reference to Automation"
    },
    "automation_name": {
      "type": "string"
    },
    "run_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "pending_approval",
        "skipped",
        "test"
      ],
      "default": "success"
    },
    "trigger_summary": {
      "type": "string"
    },
    "actions_taken": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error_message": {
      "type": "string"
    },
    "approved": {
      "type": "boolean",
      "default": false
    },
    "approved_by": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "automation_id",
    "run_date",
    "status"
  ]
}